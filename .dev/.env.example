# Copia este archivo a .env y completa solo lo que necesites:
#   cp .dev/.env.example .dev/.env
#
# setup-dev.sh lee este archivo desde /workspaces/.dev/.env (montado).
# Nunca commits .dev/.env

# ── Git (recomendado) ──────────────────────────────────────────
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"
GIT_EDITOR=nano

# ── GitHub CLI (opcional; habilita `gh` autenticado) ────────────
GITHUB_TOKEN=

# ── SSH (opcional) ─────────────────────────────────────────────
# Copia claves a .dev/secrets/ (gitignored), montado en /host-ssh:
#   cp ~/.ssh/id_ed25519* .dev/secrets/
SSH_KEY_FILE=
SSH_KEY_PUB_FILE=
SSH_HOST=github.com

# ── Docker (debe coincidir con .devcontainer/devcontainer.json) ─
DOCKER_NETWORK=go-dev
DOCKER_IMAGE=klp-chart-dev:latest
